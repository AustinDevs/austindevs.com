---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import headshot from '../../images/headshot.webp';
---
<Base path="/about" title="About"
      description="Kevin Colten is a CTO for service businesses: leading teams that ship, turning messy data into clear answers, and getting fast-growing apps ready to scale.">
  <section class="panel" data-route="/about" data-current>
    <div class="inner about">
      <img class="headshot" src={headshot.src} width={headshot.width} height={headshot.height}
           alt={SITE.name} loading="lazy" decoding="async" />
      <div class="about-copy">
        <h1 class="page-title">About {SITE.name}</h1>
        <p class="lede">
          A CTO for service businesses who knows how they actually run and builds the tech to match.
          Mixes hands-on software chops with big-picture strategy: leading teams that ship, turning messy
          data into clear answers, and taking apps from "we vibe coded this and it took off" to something
          solid enough to scale. The goal is always tech that helps the business grow and makes life easier
          for customers.
        </p>
        <div class="links">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.linkedin}>LinkedIn</a>
          <a href={SITE.schedule}>Schedule a conversation</a>
        </div>
      </div>
    </div>
  </section>
</Base>
